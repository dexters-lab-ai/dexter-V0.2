# ============================================
# Server & Application Configuration
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVER_BACKLOG=511
WS_PATH=/ws

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true

# ============================================
# Rate Limiting & Retry Configuration
# ============================================
MAX_RETRIES=10
RETRY_DELAY_MS=5000
NGROK_HEALTHCHECK_INTERVAL_MS=600000
METRICS_UPDATE_INTERVAL_MS=600000

# ============================================
# Ngrok Configuration
# ============================================
NGROK_ENABLED=false
NGROK_AUTH_TOKEN=your_ngrok_auth_token
NGROK_REGION=us

# ============================================
# Database Configuration
# ============================================
MONGO_URI=mongodb://localhost:27017/katzlife
MONGO_ENCRYPTION_KEY=generate_a_secure_32_byte_base64_key

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=generate_a_secure_jwt_secret
SESSION_SECRET=generate_a_secure_session_secret

# ============================================
# External API Keys
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_REDIRECT=http://localhost:3000/auth/google/callback

# AI & Blockchain Services
DEEP_SEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
ALCHEMY_API_KEY=your_alchemy_api_key
SOLANA_API_KEY=your_solana_api_key
MORALIS_API_KEY=your_moralis_api_key
COINGECKO_API_KEY=your_coingecko_api_key
WORMHOLE_KEY=your_wormhole_key

# Web Scraping & Data
APIFY_API_KEY=your_apify_api_key
APIFY_COOKIE_KEY=your_apify_cookie_key
BRAVE_API_KEY=your_brave_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Other Services
BITREFILL_API_KEY=your_bitrefill_api_key
COOKIEDAO_API_KEY=your_cookiedao_api_key
AVACLOUD_API_KEY=your_avacloud_api_key

# ============================================
# Smart Contracts
# ============================================
SMART_CONTRACT_ADDRESS=your_smart_contract_address

# ============================================
# Bot & Admin Configuration
# ============================================
BOT_TOKEN=your_bot_token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_PORT=3090
DASHBOARD_PORT=8080

# Session Secret (for production, use a secure random string)
SESSION_SECRET=your_session_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # limit each IP to 100 requests per windowMs
